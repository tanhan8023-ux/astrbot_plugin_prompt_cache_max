{
  "enabled": {
    "description": "Enable prompt cache maximization.",
    "type": "bool",
    "default": true
  },
  "providers": {
    "description": "Provider families to enable.",
    "type": "list",
    "default": ["openai", "anthropic", "gemini"]
  },
  "allowlist_base_urls": {
    "description": "Only these base URL prefixes receive provider-specific cache fields.",
    "type": "list",
    "default": [
      "https://api.openai.com",
      "https://api.anthropic.com",
      "https://generativelanguage.googleapis.com",
      "https://aiplatform.googleapis.com",
      "https://api.55api.com",
      "https://api.55api.com/v1",
      "https://api.55api.cn",
      "https://api.55api.cn/v1",
      "https://api.55.ai",
      "https://api.55.ai/v1",
      "https://api.55.al",
      "https://api.55.al/v1",
      "https://tokens.ai-tokens.app",
      "https://tokens.ai-tokens.app/v1"
    ]
  },
  "cache_ttl": {
    "description": "Provider cache TTL values.",
    "type": "object",
    "items": {
      "anthropic": {
        "description": "Claude cache TTL.",
        "type": "string",
        "default": "5m"
      },
      "gemini": {
        "description": "Gemini explicit cache TTL.",
        "type": "string",
        "default": "3600s"
      }
    },
    "default": {
      "anthropic": "5m",
      "gemini": "3600s"
    }
  },
  "openai_compatible_hosts": {
    "description": "Hosts that should use OpenAI-compatible prompt cache fields even when model names contain claude/gemini.",
    "type": "list",
    "default": [
      "api.55.al",
      "api.55.ai",
      "api.55api.com",
      "api.55api.cn",
      "tokens.ai-tokens.app"
    ]
  },
  "openai_prompt_cache_retention": {
    "description": "Optional OpenAI prompt cache retention field. Keep disabled for unknown compatible APIs.",
    "type": "object",
    "items": {
      "enabled": {
        "description": "Send prompt_cache_retention.",
        "type": "bool",
        "default": false
      },
      "value": {
        "description": "Retention value.",
        "type": "string",
        "default": "24h"
      }
    },
    "default": {
      "enabled": false,
      "value": "24h"
    }
  },
  "min_prefix_tokens": {
    "description": "Minimum stable prefix token estimates before explicit cache hints are used.",
    "type": "object",
    "items": {
      "openai": {
        "description": "Minimum prefix tokens before sending OpenAI prompt_cache_key.",
        "type": "int",
        "default": 512
      },
      "gemini_flash": {
        "description": "Minimum prefix tokens before trying Gemini Flash explicit cache.",
        "type": "int",
        "default": 1024
      },
      "gemini_pro": {
        "description": "Minimum prefix tokens before trying Gemini Pro explicit cache.",
        "type": "int",
        "default": 4096
      },
      "anthropic": {
        "description": "Minimum prefix tokens before adding Claude cache_control.",
        "type": "int",
        "default": 512
      }
    },
    "default": {
      "openai": 512,
      "gemini_flash": 1024,
      "gemini_pro": 4096,
      "anthropic": 512
    }
  },
  "threshold_slack_tokens": {
    "description": "Safety margin for rough token estimates. Cache hints are still sent when the estimate is slightly below the configured threshold.",
    "type": "object",
    "items": {
      "openai": {
        "description": "OpenAI-compatible threshold slack.",
        "type": "int",
        "default": 16
      },
      "anthropic": {
        "description": "Claude threshold slack.",
        "type": "int",
        "default": 16
      },
      "gemini": {
        "description": "Gemini threshold slack.",
        "type": "int",
        "default": 128
      }
    },
    "default": {
      "openai": 16,
      "anthropic": 16,
      "gemini": 128
    }
  },
  "stats_enabled": {
    "description": "Persist lightweight aggregate cache statistics.",
    "type": "bool",
    "default": true
  },
  "max_claude_cache_blocks": {
    "description": "Maximum number of Claude cache_control breakpoints to write.",
    "type": "int",
    "default": 4
  },
  "stable_style_rules": {
    "description": "Prepend a stable warm, natural, lightly teasing style block to the system prompt. This improves stable prefix length without caching repeated responses.",
    "type": "object",
    "items": {
      "enabled": {
        "description": "Enable stable style rules.",
        "type": "bool",
        "default": true
      },
      "prepend_to_system_prompt": {
        "description": "Insert the style block at the front of system_prompt.",
        "type": "bool",
        "default": true
      },
      "mode": {
        "description": "Built-in style mode.",
        "type": "string",
        "default": "warm_soft_sarcasm"
      },
      "text": {
        "description": "Optional custom stable style text. Leave empty to use the built-in warm soft-sarcasm rules.",
        "type": "string",
        "default": ""
      }
    },
    "default": {
      "enabled": true,
      "prepend_to_system_prompt": true,
      "mode": "warm_soft_sarcasm",
      "text": ""
    }
  },
  "exact_response_cache": {
    "description": "Exact response cache. Hits skip the model request completely.",
    "type": "object",
    "items": {
      "enabled": {
        "description": "Enable exact response cache.",
        "type": "bool",
        "default": false
      },
      "backend": {
        "description": "Cache backend: memory or redis.",
        "type": "string",
        "default": "memory"
      },
      "redis_url": {
        "description": "Redis URL when backend is redis.",
        "type": "string",
        "default": "redis://localhost:6379/0"
      },
      "ttl_seconds": {
        "description": "Exact cache TTL.",
        "type": "int",
        "default": 600
      },
      "max_prompt_chars": {
        "description": "Do not exact-cache prompts larger than this serialized size.",
        "type": "int",
        "default": 12000
      }
    },
    "default": {
      "enabled": false,
      "backend": "memory",
      "redis_url": "redis://localhost:6379/0",
      "ttl_seconds": 600,
      "max_prompt_chars": 12000
    }
  }
}
